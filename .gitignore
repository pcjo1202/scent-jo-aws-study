# ── 저작권 자료 ──────────────────────────────────────────────
# 원본 PDF와 추출 데이터는 제3자 저작물이며 이 레포는 public이다.
# 절대 커밋하지 않는다. 원본은 CDN에 있다 (pnpm data:pull).
data/
*.pdf
tests/fixtures/

# ── 시크릿 ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 빌드 산출물 ──────────────────────────────────────────────
# next-env.d.ts는 next dev와 next build가 서로 다른 내용으로 생성한다
# (.next/types vs .next/dev/types) — 커밋하면 tree가 영구히 더러워진다.
apps/web/next-env.d.ts
node_modules/
.next/
dist/
.turbo/
*.tsbuildinfo

# ── 플랫폼 ──────────────────────────────────────────────────
.vercel
.DS_Store

