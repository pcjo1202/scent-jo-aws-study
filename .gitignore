# ── 저작권 자료 ──────────────────────────────────────────────
# 원본 PDF와 추출 데이터는 제3자 저작물이며 이 레포는 public이다.
# 절대 커밋하지 않는다. 원본은 CDN에 있다 (pnpm data:pull).
data/
*.pdf
tests/fixtures/

# ── 시크릿 ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 빌드 산출물 ──────────────────────────────────────────────
# next-env.d.ts는 next dev와 next build가 서로 다른 내용으로 생성한다
# (.next/types vs .next/dev/types) — 커밋하면 tree가 영구히 더러워진다.
apps/web/next-env.d.ts
node_modules/
.next/
dist/
.turbo/
*.tsbuildinfo

# ── 플랫폼 ──────────────────────────────────────────────────
.vercel
.DS_Store

# 서드파티 스킬 (라이선스 미명시 — 커밋 금지, 재설치: git clone vercel-labs/agent-skills)
.claude/skills/react-best-practices/

# supabase/agent-skills도 라이선스 미명시라 같은 처리다. `.claude/skills/supabase*`는 심링크이고
# 본체는 `.agents/`에 있다. 재설치는 `npx skills add supabase/agent-skills` —
# 소스와 해시는 커밋된 `skills-lock.json`이 고정한다.
.agents/
.claude/skills/supabase
.claude/skills/supabase-postgres-best-practices
# gstack 도구 부산물 (browse 로그)
.gstack/

# playwright MCP가 QA 중에 남기는 스냅샷·콘솔 로그. 세션 산출물이라 커밋하지 않는다.
.playwright-mcp/
