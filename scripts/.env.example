# 원본 PDF 디렉터리. 기기마다 다르므로 값은 비운다 (docs/04 「data:extract」)
SOURCE_PDF_DIR=

# manifest.json의 base. 랜덤 프리픽스를 포함하므로 값은 비운다 (docs/04 「manifest.json」)
# 형태: https://<cdn>/aws-saa/<prefix>/<version>
DATA_CDN_BASE=

# 산출물 버전. 비우면 v1 (docs/04 「버전 경로를 쓰는 이유」)
DATA_VERSION=

# S3 업로드 (docs/06 「scripts」). `aws-saa/*`로 좁힌 IAM 사용자 — s3:DeleteObject 없음
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
